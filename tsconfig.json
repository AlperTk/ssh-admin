{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/pool.ts",
    "src/registry.ts",
    "src/types.ts",
    "src/readonly-checker.ts",
    "src/readonly-checker/**/*.ts",
    "src/data/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

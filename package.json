{
  "name": "ssh-admin",
  "version": "0.2.0",
  "description": "MCP server for SSH remote server management",
  "keywords": [
    "mcp",
    "ssh",
    "server",
    "ssh-admin",
    "remote",
    "management"
  ],
  "author": "AlperTk",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlperTk/ssh-admin.git"
  },
  "homepage": "https://github.com/AlperTk/ssh-admin#readme",
  "bugs": {
    "url": "https://github.com/AlperTk/ssh-admin/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ssh-admin": "./dist/bundle.cjs"
  },
  "main": "./dist/bundle.cjs",
  "files": [
    "dist/bundle.cjs",
    "dist/data",
    "!dist/**/*.map",
    "!dist/**/*.ts"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "bundle": "node build.mjs",
    "start": "node dist/bundle.cjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/ssh2": "^1.15.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/ssh2": "^1.15.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.8",
    "vitest": "^4.1.10"
  }
}

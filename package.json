{
  "name": "mcp-ssh",
  "version": "1.0.0",
  "description": "MCP server for SSH remote server management",
  "bin": {
    "mcp-ssh": "./dist/bundle.js"
  },
  "scripts": {
    "build": "tsc && node build.mjs",
    "bundle": "node build.mjs",
    "start": "node dist/bundle.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
